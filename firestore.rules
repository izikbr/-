rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // --- User Profile ---
    function isValidUser(data) {
      return data.uid == request.auth.uid 
          && data.email is string && data.email.size() <= 200
          && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
          && data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
          && data.keys().size() >= 4;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().createdAt == request.time;
      allow update: if isOwner(userId) && isValidUser(incoming()) 
                     && incoming().uid == existing().uid
                     && incoming().createdAt == existing().createdAt
                     && incoming().updatedAt == request.time;
    }

    // --- Food Logs ---
    function isValidFoodLog(data) {
      return data.userId == request.auth.uid
          && data.name is string && data.name.size() <= 256
          && data.calories is number && data.calories >= 0
          && data.protein is number && data.protein >= 0
          && data.carbs is number && data.carbs >= 0
          && data.fat is number && data.fat >= 0
          && data.timestamp is string && data.timestamp.size() <= 128
          && data.keys().hasAll(['userId', 'name', 'calories', 'timestamp', 'createdAt'])
          && data.keys().size() >= 5;
    }

    match /foodLogs/{logId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidFoodLog(incoming()) 
                  && incoming().createdAt == request.time;
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidFoodLog(incoming())
                  && incoming().userId == existing().userId
                  && incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }
  }
}
